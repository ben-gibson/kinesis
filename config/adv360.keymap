#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/stp.h>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    behaviors {
      #include "macros.dtsi"
      #include "version.dtsi"

      hm: homerow_mods {
          compatible = "zmk,behavior-hold-tap";
          label = "HOMEROW_MODS";
          #binding-cells = <2>;
          tapping-term-ms = <200>;
          quick_tap_ms = <175>;
          flavor = "tap-preferred";
          bindings = <&kp>, <&kp>;
      };

      // Every sticky modifier on this board. Stock &sk drops the modifier when
      // the NEXT KEY IS RELEASED, so a fast roll after tapping shift capitalises
      // more than one letter. quick-release drops it on the next key PRESS
      // instead, which is the whole reason this repo exists.
      //
      // quick-release only affects the tapped-and-released path: it is gated on
      // timer_started, which is set in on_sticky_key_binding_released. Hold one
      // of these and it behaves like a plain held modifier, so holding Cmd to
      // walk the app switcher still works.
      //
      // ignore-modifiers is what lets two of these chain: tap ctrl, tap shift,
      // press T and you get Ctrl+Shift+T rather than the ctrl being eaten.
      skq: sticky_quick {
          compatible = "zmk,behavior-sticky-key";
          #binding-cells = <1>;
          bindings = <&kp>;
          release-after-ms = <1000>;
          quick-release;
          ignore-modifiers;
          display-name = "Sticky";
      };

      // Hyper is a window-manager chord, not a typing modifier, so it gets a
      // longer fuse — you are usually thinking about where the window goes.
      skh: sticky_hyper {
          compatible = "zmk,behavior-sticky-key";
          #binding-cells = <1>;
          bindings = <&kp>;
          release-after-ms = <2000>;
          quick-release;
          ignore-modifiers;
          display-name = "Sticky Hyper";
      };

      // Delete had no key at all on the base layer: it was lost when Tab took
      // the thumb key it used to sit on, and it only survives on the keypad
      // layer, which is never used. Shift+Backspace is the conventional way to
      // recover it and it costs no key.
      //
      // This pairs with sticky shift rather than fighting it — tap shift, tap
      // backspace, never holding two keys at once.
      bspc_del: backspace_delete {
          compatible = "zmk,behavior-mod-morph";
          #binding-cells = <0>;
          bindings = <&kp BSPC>, <&kp DEL>;
          mods = <(MOD_LSFT|MOD_RSFT)>;
          display-name = "Bksp / Del";
      };
    };

  // Left hand opens, right hand closes, and the row picks the pair. All six
  // brackets reached the same way, without shift, without a layer:
  //
  //     R+T  (      Y+U  )
  //     F+G  [      H+J  ]
  //     V+B  {      N+M  }
  //
  // Each pair is two adjacent keys on one row under one flattened index finger,
  // and no pair crosses the split — cross-half combos are the ones that suffer
  // latency.
  //
  // require-prior-idle-ms is what keeps this safe to type on. R+T is the only
  // pair that is a common English bigram (start, part, short); prior-idle means
  // a combo cannot fire if another key went down in the last 125 ms, so a
  // mid-word roll can never reach it. If ( still misfires, lower timeout-ms
  // toward 30 before touching prior-idle.
  combos {
    compatible = "zmk,combos";

    combo_lpar {
      key-positions = <18 19>;   // R + T
      bindings = <&kp LPAR>;
      timeout-ms = <40>;
      require-prior-idle-ms = <125>;
      layers = <0>;
    };
    combo_rpar {
      key-positions = <22 23>;   // Y + U
      bindings = <&kp RPAR>;
      timeout-ms = <40>;
      require-prior-idle-ms = <125>;
      layers = <0>;
    };
    combo_lbkt {
      key-positions = <32 33>;   // F + G
      bindings = <&kp LBKT>;
      timeout-ms = <40>;
      require-prior-idle-ms = <125>;
      layers = <0>;
    };
    combo_rbkt {
      key-positions = <40 41>;   // H + J
      bindings = <&kp RBKT>;
      timeout-ms = <40>;
      require-prior-idle-ms = <125>;
      layers = <0>;
    };
    combo_lbrc {
      key-positions = <50 51>;   // V + B
      bindings = <&kp LBRC>;
      timeout-ms = <40>;
      require-prior-idle-ms = <125>;
      layers = <0>;
    };
    combo_rbrc {
      key-positions = <54 55>;   // N + M
      bindings = <&kp RBRC>;
      timeout-ms = <40>;
      require-prior-idle-ms = <125>;
      layers = <0>;
    };
  };

  keymap {
    compatible = "zmk,keymap";

    // The two inner columns either side of T and Y used to hold [ and ], which
    // now come from combos. Leaving them bound would have given the brackets a
    // second route, and a second route is exactly what stopped the old symbol
    // layer from becoming muscle memory — so they were blanked, and now carry
    // the two things that had no home at all: the nav layer and key repeat.
    default_layer {
      display-name = "Base";
      bindings = <
        &kp EQUAL &kp N1    &kp N2                &kp N3    &kp N4    &kp N5 &tog 1                                                            &mo 3      &kp N6 &kp N7 &kp N8    &kp N9  &kp N0   &kp MINUS
        &kp TAB   &kp Q     &kp W                 &kp E     &kp R     &kp T  &kp ESC                                                           &key_repeat &kp Y &kp U  &kp I     &kp O   &kp P    &kp BSLH
        &kp ESC   &kp A     &kp S                 &kp D     &kp F     &kp G  &mo 4            &skq LCTRL &kp LGUI &kp LGUI  &skq LCTRL         &caps_word &kp H  &kp J  &kp K     &kp L   &kp SEMI &kp SQT
        &skq LSHFT &kp Z    &kp X                 &kp C     &kp V     &kp B                             &kp HOME &kp PG_UP                                &kp N  &kp M  &kp COMMA &kp DOT &kp FSLH &skq RSHFT
        &mo 2     &kp GRAVE &skh LS(LC(LA(LGUI))) &skq LALT &skq LGUI                &bspc_del &kp TAB  &kp END  &kp PG_DN &kp ENTER &kp SPACE            &kp LEFT &kp DOWN &kp UP  &kp RIGHT        &mo 2
      >;
    };
    keypad {
      display-name = "Kp";
      bindings = <
        &kp EQUAL &kp N1    &kp N2   &kp N3   &kp N4     &kp N5 &trans                                                           &mo 3 &kp N6 &kp KP_NUM &kp KP_EQUAL &kp KP_DIVIDE &kp KP_MULTIPLY &kp MINUS
        &kp TAB   &kp Q     &kp W    &kp E    &kp R      &kp T  &none                                                            &none &kp Y  &kp KP_N7  &kp KP_N8    &kp KP_N9     &kp KP_MINUS    &kp BSLH
        &kp ESC   &kp A     &kp S    &kp D    &kp F      &kp G  &none           &kp LCTRL &kp LALT &kp LGUI  &kp RCTRL           &none &kp H  &kp KP_N4  &kp KP_N5    &kp KP_N6     &kp KP_PLUS     &kp SQT
        &kp LSHFT &kp Z     &kp X    &kp C    &kp V      &kp B                            &kp HOME &kp PG_UP                           &kp N  &kp KP_N1  &kp KP_N2    &kp KP_N3     &kp KP_ENTER    &kp RSHFT
        &mo 2     &kp GRAVE &kp CAPS &kp LEFT &kp RIGHT                &kp BSPC &kp DEL   &kp END  &kp PG_DN &kp ENTER &kp KP_N0              &kp UP     &kp DOWN     &kp KP_DOT    &kp RBKT        &mo 2
      >;
    };
    // Media and brightness sit under the right hand, because Fn is held from
    // either bottom-row corner — hold it with the left pinky and the whole
    // right hand is free.
    //
    // The arrangement is vim motion rather than anything new to learn:
    // j/k is down/up so it is volume, h/l is left/right so it is track. U and I
    // are in the same two columns as J and K, so brightness is the same two
    // fingers one row up. Space is play/pause because Space is always
    // play/pause.
    //
    //          U      I          bri- / bri+
    //    H     J      K     L     ;
    //   prev  vol-  vol+  next  mute
    //          Space = play/pause
    fn {
      display-name = "Fn";
      bindings = <
        &kp F1 &kp F2 &kp F3 &kp F4 &kp F5 &kp F6 &tog 1                                            &mo 3 &kp F7     &kp F8       &kp F9       &kp F10    &kp F11    &kp F12
        &trans &trans &trans &trans &trans &trans  &none                                            &none &trans     &kp C_BRI_DN &kp C_BRI_UP &trans     &trans     &trans
        &trans &trans &trans &trans &trans &trans  &none        &trans &trans &trans &trans         &none &kp C_PREV &kp C_VOL_DN &kp C_VOL_UP &kp C_NEXT &kp C_MUTE &trans
        &trans &trans &trans &trans &trans &trans                       &trans &trans                     &trans     &trans       &trans       &trans     &trans     &trans
        &trans &trans &trans &trans &trans               &trans &trans &trans &trans &trans &kp C_PP            &trans &trans &trans  &trans  &trans
      >;
    };
    mod {
      display-name = "Mod";
      bindings = <
        &none &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4 &none                                                                     &trans                 &none        &none        &none        &none &none &none
        &none &none        &none        &none        &none        &none        &bootloader                                                               &bootloader            &none        &none        &none        &none &none &none
        &studio_unlock &none        &none        &none        &none        &none        &none                   &none &none &bt BT_CLR &none                      &stp STP_BAT &none        &none        &none        &none &none &none
        &none &none        &none        &none        &macro_ver   &none                                      &none &none                                                        &none        &none        &none        &none &none &none
        &none &none        &none        &none        &none                                       &none &none &none &none      &bl BL_TOG &rgb_ug RGB_TOG                                     &bl BL_INC   &bl BL_DEC   &none &none &none
      >;
    };
    // Held with the left index from the inner column beside G, so the whole
    // right hand is free. The board shows a red indicator while it is live.
    //
    // That key and the duplicate Esc were swapped on 2026-09-12, on trial: all
    // three left inner-column keys sit in one column, and this one is on the
    // home row where the one above it is a reach. A key you hold belongs on the
    // home row; a key you tap can afford the reach, and Esc is duplicated on
    // the pinky anyway. Revert by swapping them back if it does not settle.
    //
    // No plain arrows here on purpose. They already have dedicated keys on the
    // base layer, and duplicating them would be the same mistake the symbol
    // layer made. This layer carries only the motions that have no home at all.
    //
    // Left two go left, right two go right; outer jumps by word, inner by line.
    // Y U I O sit directly above H J K L, so the row above is the same motion
    // with shift added — select instead of move. Same finger, one row up.
    //
    //     Y       U       I       O
    //    sel     sel     sel     sel        select
    //    word    line    line    word
    //
    //     H       J       K       L       ;       '
    //    word    line    line    word    del     del      move / delete
    //     <-      <-      ->      ->     word    line
    //
    //     ,       .       /
    //    zoom    zoom    zoom              , is < and . is > — out and in
    //    out      in     reset
    nav {
      display-name = "Nav";
      bindings = <
        &none  &none  &none  &none  &none  &none  &none                                        &none  &none            &none            &none             &none             &none        &none
        &trans &none  &none  &none  &none  &none  &trans                                       &trans &kp LS(LA(LEFT)) &kp LS(LG(LEFT)) &kp LS(LG(RIGHT)) &kp LS(LA(RIGHT)) &none        &trans
        &trans &none  &none  &none  &none  &none  &trans       &trans &trans &trans &trans     &none  &kp LA(LEFT)     &kp LG(LEFT)     &kp LG(RIGHT)     &kp LA(RIGHT)     &kp LA(BSPC) &kp LG(BSPC)
        &trans &none  &none  &none  &none  &none                      &trans &trans                   &none            &none            &kp LG(MINUS)     &kp LG(EQUAL)     &kp LG(N0)   &trans
        &trans &none  &trans &trans &trans              &trans &trans &trans &trans &trans &trans            &trans &trans &trans  &trans  &trans
      >;
    };

    extra2 {
      display-name = "Purple";
      status = "reserved";
    };

    extra3 {
      display-name = "Cyan";
      status = "reserved";
    };

    extra4 {
      display-name = "Yellow";
      status = "reserved";
    };
  };
};
